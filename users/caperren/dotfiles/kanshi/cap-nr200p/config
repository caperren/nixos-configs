# `hyprctl monitors list` for all outputs

profile workshop_den {
    ##### Top left to right
    output "Dell Inc. DELL P2411H F8NDP097114U" enable position -1680,-1640
    output "Dell Inc. DELL P2411H F8NDP11G0DVU" enable position 2320,-1640

    ##### Bottom left to right
    output "Aculab Ltd Digital Unknown" enable transform 270 position -1440,-560
    # Primary monitor, which wayland doesn't have a concept of
    output "Hewlett Packard HP Z27n CNK7311DRR" enable position 0,0
    output "Aculab Ltd QHD270 Unknown" enable transform 90 position 2560,-560
}

profile office_desk {
    output "Hewlett Packard HP Z27n CNK7311FCY" enable position 0,0
    output "LG Electronics LG ULTRAGEAR 104NTVS1N751" enable mode 3440x1440@143.92Hz position -440,1440 adaptive_sync on
    output "BOE Display 0x00000060" enable position 1280,2880 scale 1.0
    output "AOC 1659WX        1234567      " enable position -640,2880 scale 1.0
}

profile office_desk_vr {
    output "LG Electronics LG ULTRAGEAR 104NTVS1N751" enable mode 3440x1440@143.92Hz position -440,0 adaptive_sync on
    output "BOE Display 0x00000060" enable position 1280,1440 scale 1.0
    output "AOC 1659WX        1234567      " enable position -640,1440 scale 1.0
}
